<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Class? Yes! Move tab: a tiny Windows helper that hangs a finger-sized Move tab off the floating
    class goal and moves the window as the finger slides. .NET Framework 4.8 is part of Windows 10
    and 11, so the program is one small file with nothing to install. It builds on Linux too (the
    reference assemblies come from NuGet), which is how the site's deploy makes it.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ClassYesMove</AssemblyName>
    <RootNamespace>ClassYesMove</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Deterministic>true</Deterministic>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Product>Class? Yes! Move tab</Product>
    <Version>0.1.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
</Project>
